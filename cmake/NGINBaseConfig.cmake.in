# cmake/NGINBaseConfig.cmake.in
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@NGIN_BASE_TLS_WITH_OPENSSL@)
  find_dependency(OpenSSL 3 COMPONENTS SSL Crypto)
elseif(@NGIN_BASE_CRYPTO_WITH_OPENSSL@)
  find_dependency(OpenSSL 3 COMPONENTS Crypto)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/NGINBaseTargets.cmake")

set(_ngin_available_components @NGIN_BASE_ENABLED_COMPONENTS@)

foreach(_ngin_component IN LISTS _ngin_available_components)
  if(TARGET NGIN::Base${_ngin_component}Static AND
     NOT TARGET NGIN::Base::${_ngin_component}::Static)
    add_library(NGIN::Base::${_ngin_component}::Static ALIAS NGIN::Base${_ngin_component}Static)
  endif()
  if(TARGET NGIN::Base${_ngin_component}Shared AND
     NOT TARGET NGIN::Base::${_ngin_component}::Shared)
    add_library(NGIN::Base::${_ngin_component}::Shared ALIAS NGIN::Base${_ngin_component}Shared)
  endif()

  if(TARGET NGIN::Base${_ngin_component}Shared)
    set(_ngin_component_primary NGIN::Base${_ngin_component}Shared)
  elseif(TARGET NGIN::Base${_ngin_component}Static)
    set(_ngin_component_primary NGIN::Base${_ngin_component}Static)
  else()
    message(FATAL_ERROR "NGIN.Base component ${_ngin_component} is missing from the package")
  endif()

  if(NOT TARGET NGIN::Base::${_ngin_component})
    add_library(NGIN::Base::${_ngin_component} ALIAS ${_ngin_component_primary})
  endif()
  set(NGINBase_${_ngin_component}_FOUND TRUE)
endforeach()

if(TARGET NGIN::BaseStatic AND NOT TARGET NGIN::Base::Static)
  add_library(NGIN::Base::Static ALIAS NGIN::BaseStatic)
endif()
if(TARGET NGIN::BaseShared AND NOT TARGET NGIN::Base::Shared)
  add_library(NGIN::Base::Shared ALIAS NGIN::BaseShared)
endif()

if(TARGET NGIN::BaseShared)
  set(_ngin_base_primary_target NGIN::BaseShared)
elseif(TARGET NGIN::BaseStatic)
  set(_ngin_base_primary_target NGIN::BaseStatic)
else()
  message(FATAL_ERROR "NGIN.Base aggregate target is missing from the package")
endif()

if(NOT TARGET NGIN::Base)
  add_library(NGIN::Base ALIAS ${_ngin_base_primary_target})
endif()

check_required_components(NGINBase)
