foreach(mode IN ITEMS live supervisor joining joined)
  execute_process(COMMAND "${FIXTURE}" "${mode}" RESULT_VARIABLE result TIMEOUT 10)
  if(mode STREQUAL "joined")
    set(expected 0)
  else()
    set(expected 86)
  endif()
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Scope lifetime ${mode}: expected ${expected}, got ${result}")
  endif()
endforeach()
